{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Control del Invernadero IoT",
    "version": "0.0.0",
    "description": "Contrato de comunicación entre ESP32, Backend y Frontend."
  },
  "paths": {
    "/metrics/:idDevice": {
      "post": {
        "summary": "Envío de metricas (ESP32 -> Backend)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/metricPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Metricas guardadas exitosamente."
          },
          "206": {
            "description": "Metricas guardadas parcialmente. Revisar los siguientes sensores: []"
          }
        }
      }
    },
    "/metrics/:idDevice/history?:sensorType": {
      "get": {
        "summary": "Historial de telemetría (Frontend -> Backend)",
        "responses": {
          "200": {
            "description": "Lista de mediciones.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/metricResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics/:idDevice/latest?sensorType=:sensorType": {
      "get": {
        "summary": "Última medición en vivo (Frontend -> Backend)",
        "responses": {
          "200": {
            "description": "Ultima medicion en vivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "metricPayload": {
        "type": "object",
        "required": ["soilHum", "airHum", "temp", "waterLevel", "timestamp"],
        "properties": {
          "soilHum": {
            "type": "number",
            "example": 45.5
          },
          "airHum": {
            "type": "number",
            "example": 24.2
          },
          "temp": {
            "type": "number",
            "example": 60
          },
          "waterLevel": {
            "type": "number",
            "example": 85
          }
        }
      },
      "metricResponse": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number",
            "example": 45.5
          },
          "date": {
            "type": "Date",
            "example": "2026-10-31T14:30:00"
          }
        }
      }
    }
  }
}
